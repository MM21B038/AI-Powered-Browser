{
  "name": "autonomous-browser",
  "version": "1.0.0",
  "description": "AI-powered Chromium browser with chat automation",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('node:fs'),p=require('node:path');const d=p.join('dist','electron','electron');for(const f of['chrome-importer.impl.js','firefox-importer.impl.js'])fs.copyFileSync(p.join('electron',f),p.join(d,f));\"",
    "build:renderer": "vite build",
    "build:app": "npm run build:electron && npm run build:renderer",
    "start": "npm run build:app && electron .",
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --remote-debugging-port=9222\"",
    "build": "npm run build:app && electron-builder",
    "pack": "npm run build:app && electron-builder --dir",
    "smoke": "npm run pack",
    "dist": "npm run build:app && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "keywords": [
    "browser",
    "ai",
    "automation",
    "electron"
  ],
  "author": "",
  "build": {
    "appId": "com.autonomousbrowser.app",
    "productName": "Autonomous Browser",
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.0.3",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sqlite3": "^6.0.1",
    "zustand": "^5.0.8"
  }
}
