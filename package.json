{
  "name": "autonomous-browser",
  "version": "1.0.0",
  "description": "AI-powered Chromium browser with chat automation",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "dev": "npx electron . --remote-debugging-port=9222",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "browser",
    "ai",
    "automation",
    "electron"
  ],
  "author": "",
  "dependencies": {
    "axios": "^1.6.0",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.autonomousbrowser.app",
    "productName": "Autonomous Browser",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-rebuild": "^3.2.9"
  }
}
