{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/electron",
    "rootDir": ".",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/test-*.ts"]
}
